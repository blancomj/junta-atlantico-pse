{
  "name": "junta-atlantico-pse-backend",
  "version": "2.0.0",
  "description": "Backend para integración PSE Avanza v21",
  "main": "dist/backend/server.js",
  "scripts": {
    "build": "echo \"Build omitido: dist/ incluido en el zip\"",
    "start": "node dist/backend/server.js",
    "dev": "cross-env NODE_ENV=development ts-node server.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:integration": "jest tests/integration --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node src/database/seed.ts",
    "migrate": "ts-node src/database/apply-migrations.ts",
    "migrate:dev": "cross-env NODE_ENV=development ts-node src/database/apply-migrations.ts",
    "db:copy-to-dev": "ts-node src/database/copy-to-dev.ts"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.5",
    "uuid": "^14.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
